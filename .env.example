# ── Raggy environment configuration ─────────────────────────────────────────
# Copy this file to .env and fill in your values.

# Gemini API key (get one at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Optional LiteLLM model string. Leave empty to use gemini/GEMINI_CHAT_MODEL.
LITELLM_MODEL=

# Sentence-Transformers local embedding model
LOCAL_EMBED_MODEL=cnmoro/snowflake-arctic-embed-m-v2.0-cpu
LOCAL_EMBED_DIM=256

# Qdrant — use "./qdrant_data" for persistent local disk, ":memory:" for transient in-memory, or "http://localhost:6333" for server
QDRANT_URL=./qdrant_data
QDRANT_COLLECTION=kb_text_chunks
MEMORY_COLLECTION=kb_memory_records

# Enable only while evaluating compound retrieval questions. It uses at most
# three model-generated subqueries and falls back to the original question.
QUERY_DECOMPOSITION_ENABLED=false

# Archived SQLite paths. They remain the default only when running ``python main.py``
# without the PostgreSQL launcher below.
METADATA_DB_PATH=./raggy_metadata.sqlite3
MEMORY_DB_PATH=./raggy_memory.sqlite3
AUTHORITATIVE_DB_BACKEND=sqlite
# PostgreSQL connection for the local development container. Use
# ``./scripts/run_postgres_dev.sh`` to select it as the complete authority.
POSTGRES_PASSWORD=password
# Host port for the optional local Postgres container. 5433 avoids conflicts
# with an already-running local PostgreSQL installation.
POSTGRES_PORT=5433
POSTGRES_DATABASE_URL=postgresql://raggy:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/raggy
POSTGRES_SCHEMA=public
# Optional overrides for scripts/run_postgres_dev.sh (normally leave blank).
# RAGGY_POSTGRES_PORT=5433
# RAGGY_POSTGRES_DATABASE_URL=postgresql://raggy:password@localhost:5433/raggy
# Derived graph projection. Keep this separate from the archived SQLite memory DB
# when PostgreSQL becomes the authoritative backend.
GRAPH_DB_PATH=./raggy_graph_projection.sqlite3
# Rebuildable graph projection backend for ordinary ``python main.py`` runs.
# SQLite remains the safe default. ``run_postgres_dev.sh`` deliberately selects
# FalkorDB instead; start it with ``podman compose --profile postgres --profile falkor up -d``.
GRAPH_PROJECTION_BACKEND=sqlite
FALKORDB_URL=redis://127.0.0.1:6380
FALKORDB_GRAPH_NAME=raggy_memory_projection_v1
# Optional Postgres/Falkor profile-only overrides. Use sqlite here only as a
# rollback for the Postgres launcher; it never changes plain local startup.
# RAGGY_GRAPH_PROJECTION_BACKEND=falkor
# RAGGY_FALKORDB_URL=redis://127.0.0.1:6380
# RAGGY_FALKORDB_GRAPH_NAME=raggy_memory_projection_v1
# Read-only one-hop relationship expansion for the memory planner. Keep off
# until the local Falkor projection has been validated.
GRAPH_MEMORY_EXPANSION_ENABLED=false
GRAPH_MEMORY_EXPANSION_LIMIT=4
FALKORDB_PORT=6380
FALKORDB_BROWSER_PORT=3001
# Optional host ports for the all-in-one container stack. These do not affect
# service-to-service container addresses, which use Compose DNS names.
# RAGGY_APP_PORT=8000
# QDRANT_PORT=6333
# Separate derived-data paths used by scripts/run_postgres_dev.sh. These are
# intentionally fresh and never touch the archived SQLite/Qdrant data above.
POSTGRES_QDRANT_URL=./qdrant_postgres_data
POSTGRES_QDRANT_COLLECTION=raggy_postgres_evidence
POSTGRES_MEMORY_COLLECTION=raggy_postgres_memories
POSTGRES_UPLOAD_DIR=./uploaded_files_postgres
POSTGRES_GRAPH_DB_PATH=./raggy_graph_postgres.sqlite3
# Local durable sessions/messages. Defaults to the memory database so both
# relational authorities migrate together to Postgres later.
SESSION_DB_PATH=./raggy_memory.sqlite3

# Chunking
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# Retrieval
RETRIEVAL_TOP_K=5
